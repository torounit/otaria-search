{
	"name": "wp-mariadb-vector-search",
	"version": "0.1.0",
	"description": "WordPress plugin for MariaDB vector search.",
	"license": "GPL-2.0-or-later",
	"private": true,
	"wpPlugin": {
		"name": "wp_mariadb_vector_search",
		"handlePrefix": "wp_mariadb_vector_search",
		"pages": [
			"wp-mariadb-vector-search"
		]
	},
	"scripts": {
		"build:routes": "wp-build",
		"build": "npm run build:routes",
		"format": "wp-scripts format",
		"lint:js:fix": "wp-scripts lint-js --fix",
		"lint:js": "wp-scripts lint-js",
		"lint:php:fix": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/wp-mariadb-vector-search composer run-script format",
		"lint:php": "wp-env --config=.wp-env.test.json run cli --env-cwd=wp-content/plugins/wp-mariadb-vector-search composer run-script lint",
		"start:routes": "wp-build --watch",
		"start": "npm run start:routes",
		"test:php": "npm-run-all test:php:setup test:php:base",
		"test:php:setup": "wp-env --config=.wp-env.test.json start",
		"test:php:base": "wp-env --config=.wp-env.test.json run --env-cwd='wp-content/plugins/wp-mariadb-vector-search' wordpress vendor/bin/phpunit -c phpunit.xml.dist",
		"typecheck": "tsc --noEmit",
		"wp-env": "wp-env",
		"wp-env:cli": "wp-env run cli --env-cwd=wp-content/plugins/wp-mariadb-vector-search",
		"wp-env:test": "wp-env --config=.wp-env.test.json"
	},
	"devDependencies": {
		"@types/react": "^18.3.28",
		"@types/react-dom": "^18.3.7",
		"@wordpress/build": "^0.26.0",
		"@wordpress/env": "^12.0.0",
		"@wordpress/scripts": "^36.1.0",
		"npm-run-all": "^4.1.5",
		"typescript": "^6.0.3"
	},
	"dependencies": {
		"@wordpress/admin-ui": "^3.0.0",
		"@wordpress/api-fetch": "^8.0.0",
		"@wordpress/components": "^43.0.0",
		"@wordpress/element": "^10.0.0",
		"@wordpress/i18n": "^7.0.0",
		"@wordpress/notices": "^6.0.0",
		"react": "^18.3.1"
	},
	"engines": {
		"node": ">=24",
		"npm": ">=10.9.4"
	},
	"overrides": {
		"react": "^18.3.1",
		"react-dom": "^18.3.1"
	}
}
